# .dflow.local — D'Flow 에이전트 개인 설정. git 에 올리지 않는다(.gitignore). 값은 어디에도 출력·붙여넣지 않는다.

# 개인 액세스 토큰 — D'Flow 웹 /account "내 토큰" 에서 발급. 쉼표로 여러 개(첫 토큰이 기본). 하나면 pat= 도 된다.
pats=

# 토큰이 둘 이상일 때 이 리포가 쓸 키의 prefix(토큰의 셋째 '_' 칸). 비우면 첫 토큰. 목록은 dflow.sh profiles.
# /dflow-team 은 비어 있으면 시작할 때 정해서 파일 끝에 적는다.
as=

# 내 개발 브랜치(필수). 에이전트 머지·스택 기점·반영 확인의 기준이다. 동료와 같은 이름을 쓰면 그 브랜치를 공유한다.
# 운영 브랜치에서 직접 개발하면 그 이름(예 main)을 적는다. 원격에 먼저 push 돼 있어야 한다.
dev_branch=

# 1 이면 팀장이 완료 보고된 작업을 승인 전에 개발 브랜치로 머지한다. 기본 0.
automerge=0

# 내가 맡은 서브시스템의 DOCS_DIR=프로젝트 UUID(쉼표 구분). 리포 전체가 한 프로젝트면 비운다.
# project_map=docs/c10=<uuid>

# 1 이면 이 PC 에서 docker 태그 Task 의 워커와 수동 /dflow-dev 도 도커를 쓰지 않는다(강제 금지). .dflow 의 no_docker 를
# 덮는다. 워커는 이 값과 무관하게 기본이 금지다(0 으로 풀 수 없다 — 허용은 D'Flow 의 docker 태그로만). 정본: dev-discipline.md
# 「도커 사용 규칙」.
# no_docker=1

# 방언 검증 명령(.dflow 의 dialect_check 를 덮는다). PC 전용 값(JAVA_HOME 등)이 든 명령은 .dflow.local 에 둔다.
# 정본: .claude/skills/dflow-merge/SKILL.md 「방언 검증」.
# dialect_check=cd src/backend/mdm && JAVA_HOME=/opt/homebrew/opt/openjdk@21/libexec/openjdk.jdk/Contents/Home ../gradlew :api:mssqlMigrationTest --no-daemon --console=plain

# Build 모델 시험(기본 꺼짐). 배정표가 opus 로 정한 Build 중 일부를 sonnet(+정해진 시점 advisor)으로 돌려 비교한다.
# sonnet 밖의 값은 꺼짐이다(haiku Build 금지). 목록이 있으면 목록만 보고, 없으면 비율(TSK ID 로 결정적 판정 — 재개해도 같다).
# 판정은 Phase 01 에서 한 번 하고 state.json 에 적는다. 정본: dflow-dev/references/dev-discipline.md 「Build 모델 시험(build_model_trial)」.
# build_model_trial=sonnet
# build_model_trial_rate=30
# build_model_trial_tasks=TSK-02-05,WP-03,dict/WP-01
# /dflow-team 팀원의 첫 턴 컨텍스트 줄이기(선택). 적지 않으면 종전과 같다. dflow-* 와 이 리포의 프로젝트 스킬은 늘 남는다.
# 적은 이름이 이 PC 에 없으면 경고 한 줄만 내고 진행한다. 정본: .claude/skills/dflow-team/references/backends.md 「첫 턴 컨텍스트 줄이기」.
# worker_keep_skills=<남길 사용자 스킬 이름, 쉼표. 예: 브라우저 E2E 스킬. 없으면 none>
# worker_skills_off=<그 밖에 끌 스킬 이름, 쉼표. 예: 쓰지 않는 Claude Code 내장 스킬>
# worker_keep_plugins=<켜 둘 플러그인 이름@마켓, 쉼표. 없으면 none>
# worker_output_style=default

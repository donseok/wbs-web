# dflow-kit — D'Flow 에이전트 스킬 설정. 이 파일은 git 에 올리지 않는다(install.sh 가 .gitignore 에 넣는다).
# 값은 채운 뒤 어디에도 출력·붙여넣기하지 않는다. 스크립트는 env 확장으로만 읽는다.

# D'Flow 서버. 스테이징에서 먼저 검증하고 운영으로 옮긴다.
DFLOW_API_BASE=https://dflow-staging.vercel.app
# 운영: DFLOW_API_BASE=https://wbs-web.vercel.app

# 개인 액세스 토큰 — D'Flow 웹 /account "내 토큰" 에서 발급. 쉼표로 여러 개 가능(첫 토큰이 기본).
DFLOW_PATS=

# 이 리포가 속한 D'Flow 프로젝트 UUID — wbs.md 업로드·export 바인딩용(프로젝트 URL /p/<UUID>/ 에서 복사).
DFLOW_PROJECT_ID=
